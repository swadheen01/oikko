rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Is the caller an admin? Backed by a small `admins/{authUid}` marker
    // collection (doc just needs to exist) instead of assuming the
    // member doc ID equals the Auth uid — it never does, since member doc
    // IDs are auto-generated (README section 4.4) and only linked to an
    // account via the `authUid` field. The marker doc is created manually
    // in the Firebase console alongside setting role: "admin" — see
    // ADMIN_SETUP.md.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A super admin is an admin whose marker doc carries superAdmin: true.
    // It exists so one account can hold the powers that would otherwise let
    // any admin lock everyone else out — granting/revoking admin rights,
    // and the irreversible "clear everything" actions.
    //
    // A super admin normally has no `members` record at all, so they don't
    // appear in the member directory and no other admin can see the account
    // exists: the `admins` collection isn't listable, and each caller can
    // read only their own marker doc.
    function isSuperAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.superAdmin == true;
    }

    // Does `memberId` (a `members` collection doc ID, as stored on
    // transactions/welfare_requests) belong to the caller? Resolved by
    // reading that member doc's `authUid` field directly — no reverse
    // index needed since the doc ID is already known from the resource.
    function isOwnMemberRecord(memberId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/members/$(memberId)).data.authUid == request.auth.uid;
    }

    // Admin marker collection — only ever managed manually via the Firebase
    // console (never writable from a client, or being admin would be
    // self-grantable). isAdmin() above doesn't depend on this read rule:
    // rules' own get()/exists() calls bypass rules on the referenced path.
    //
    // Callers may read exactly one doc — their own — so the app can tell
    // an admin that their marker doc is missing instead of surfacing an
    // opaque permission-denied on every action they attempt. Reading only
    // your own uid leaks nothing: you already know whether you're an admin
    // by whether anything works.
    match /admins/{authUid} {
      allow read: if request.auth != null && request.auth.uid == authUid;

      // Any admin may grant or revoke ordinary admin rights, but a super
      // admin's marker is off limits to them: without that guard, an admin
      // could delete the owner's own marker (a delete is just a write) and
      // lock them out of their own app.
      //
      // They also can't mint a new super admin — that would let an admin
      // hand themselves the protected tier through an accomplice.
      //
      // Writing your own marker is always blocked: creating it would be
      // self-promotion, deleting it would lock you out. The first super
      // admin is made by hand in the Firebase console — see ADMIN_SETUP.md.
      //
      // Split by operation because `request.resource` is null on delete and
      // `resource` is null on create; a single `write` rule touching both
      // would error out and deny everything.
      allow create: if request.auth != null && request.auth.uid != authUid && (
        isSuperAdmin() ||
        (isAdmin() && request.resource.data.superAdmin != true)
      );

      allow update: if request.auth != null && request.auth.uid != authUid && (
        isSuperAdmin() ||
        (isAdmin() &&
         resource.data.superAdmin != true &&
         request.resource.data.superAdmin != true)
      );

      allow delete: if request.auth != null && request.auth.uid != authUid && (
        isSuperAdmin() ||
        (isAdmin() && resource.data.superAdmin != true)
      );
    }

    // Members collection - read all, write only own.
    // NOTE: memberId is an auto-generated doc ID (see README section 4.4),
    // never equal to the Firebase Auth uid — a member's own doc is found via
    // its `authUid` field instead, so "own record" checks below compare
    // resource.data.authUid to request.auth.uid, not the doc ID.
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;

      allow update: if isAdmin()
        // Auto-claim (section 4.9, Flow A): only allowed while authUid is
        // still unset, and only to attach the requester's own uid.
        || (
          request.auth != null &&
          resource.data.authUid == null &&
          request.resource.data.authUid == request.auth.uid &&
          request.auth.token.email_verified == true
        )
        // Self-edit (profile screen): the already-linked owner may update
        // their own profile fields, but not role/status/authUid/isClaimed.
        || (
          request.auth != null &&
          resource.data.authUid == request.auth.uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.authUid == resource.data.authUid &&
          request.resource.data.isClaimed == resource.data.isClaimed
        );

      allow delete: if isAdmin();
    }

    // Link requests - read for member/admin, write authenticated
    match /link_requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.requestedByUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notices - read all, write admin only
    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Welfare requests - read own/admin, create own, review admin only
    match /welfare_requests/{requestId} {
      allow read: if isOwnMemberRecord(resource.data.memberId) || isAdmin();
      allow create: if isOwnMemberRecord(request.resource.data.memberId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Personal notifications - a private per-member inbox. Only the owner
    // (matched by the denormalized authUid, or by resolving the member doc)
    // and admins may read; only admins create them (a payment confirmation
    // is an admin action); the owner may delete/mark-read their own.
    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.authUid == request.auth.uid)
        || isOwnMemberRecord(resource.data.memberId);
      allow create: if isAdmin();
      allow update, delete: if isAdmin()
        || (request.auth != null && resource.data.authUid == request.auth.uid)
        || isOwnMemberRecord(resource.data.memberId);
    }

    // Committee — the elected office bearers shown on the About page. Anyone
    // signed in can read; only admins edit (name, designation, photo).
    match /committee/{memberId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Polls - read all, create/delete admin only, update (voting) any member
    match /polls/{pollId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Transactions - read own/admin; only admin can log payments/income/expense.
    // memberId is nullable (null = general association income/expense, not
    // tied to a member — see models/transaction.dart), so it's checked
    // before resolving ownership to avoid a get() on a null path.
    match /transactions/{transactionId} {
      allow read: if isAdmin()
        || (resource.data.memberId != null && isOwnMemberRecord(resource.data.memberId));
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
